{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://layout-ddd.local/schemas/non_rectangular_agent/submission_v1.schema.json",
  "title": "NonRectangularAgentSubmissionV1",
  "description": "Final Agent-track plan, shared-database asset bindings, and global placement.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "layout_id",
    "object_plan",
    "asset_bindings",
    "global_placement"
  ],
  "properties": {
    "schema_version": {
      "const": "non_rectangular_agent_submission_v1"
    },
    "layout_id": {
      "$ref": "#/$defs/stableId"
    },
    "object_plan": {
      "type": "object"
    },
    "asset_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/assetBinding"
      }
    },
    "global_placement": {
      "type": "object"
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "assetBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["room_id", "slot_id", "asset_id"],
      "properties": {
        "room_id": {
          "$ref": "#/$defs/stableId"
        },
        "slot_id": {
          "$ref": "#/$defs/stableId"
        },
        "asset_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    }
  }
}
