{
  "harness_id": "sieve-pi-common-harness-v1",
  "implementation": {
    "name": "Pi Coding Agent",
    "npm_package": "@earendil-works/pi-coding-agent",
    "version": "0.85.0"
  },
  "isolation": {
    "outer_boundary": "macos_seatbelt_sandbox_exec_v1",
    "project_trust": "never",
    "session_persistence": false
  },
  "model_access": {
    "credential_source": "ARENA_MODEL_GATEWAY_TOKEN",
    "fixed_identity_enforced_by_host_gateway": true,
    "provider_id": "sieve-gateway",
    "supported_protocols": [
      "openai-completions",
      "openai-responses"
    ],
    "upstream_credentials_visible_to_agent": false
  },
  "resources": {
    "context_files": false,
    "extensions": false,
    "prompt_templates": false,
    "skills": false,
    "themes": false
  },
  "runtime": {
    "cli_relative_path": "node_modules/@earendil-works/pi-coding-agent/dist/bundle/cli.js",
    "local_bundle_relative_to_arena": "../runtime_bundles/pi-0.85.0",
    "node_relative_path": "bin/node",
    "runtime_manifest": "../runtime_bundles/pi-0.85.0/runtime.manifest.json"
  },
  "schema_version": "sieve_pi_common_harness_v1",
  "system_prompt_path": "trusted/pi_harness/SYSTEM.md",
  "task_delivery": {
    "canonical_source": "workspace/TODO.md",
    "encoding": "utf-8",
    "method": "stdin_utf8_canonical_text"
  },
  "tools": {
    "allowlist": [
      "read",
      "write",
      "edit",
      "bash"
    ],
    "effective_filesystem_scope": "episode_workspace_only",
    "effective_network_scope": "one_scoped_loopback_model_gateway_plus_database_unix_socket"
  }
}
