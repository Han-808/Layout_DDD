{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/layout-ddd/visual_style_spec.schema.json",
  "title": "VisualStyleSpec",
  "description": "Benchmark-owned, frozen appearance specification compiled into the Visual Quality judge prompt. Generator output and runtime prompt parsing are never spec sources.",
  "type": "object",
  "additionalProperties": true,
  "required": ["spec_version", "source", "frozen", "directives"],
  "properties": {
    "spec_version": {"const": "visual_style_spec_v1"},
    "source": {
      "enum": [
        "benchmark_annotation",
        "benchmark_owned",
        "trusted_case_bundle",
        "manual",
        "programmatic",
        "diagnostic"
      ],
      "description": "Official specs must use a benchmark-owned source (benchmark_annotation / benchmark_owned / trusted_case_bundle)."
    },
    "frozen": {"type": "boolean"},
    "compiled_from": {"type": "string"},
    "scene_type": {"type": "string"},
    "directives": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/directive"}
    }
  },
  "$defs": {
    "directive": {
      "type": "object",
      "additionalProperties": true,
      "required": ["directive_id", "statement"],
      "properties": {
        "directive_id": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1},
        "required": {"type": "boolean", "default": true},
        "source_span": {"type": ["string", "null"]}
      }
    }
  }
}
