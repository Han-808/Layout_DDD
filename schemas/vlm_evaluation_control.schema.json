            "selection_mode": {
              "type": "string",
              "enum": [
                "candidate_only",
                "repair_plan",
                "freeform_pose"
              ],
              "default": "repair_plan"
            },
            "max_selected_views": {
              "type": "integer",
              "minimum": 1,
              "default": 2
            },
            "max_repair_plans": {
              "type": "integer",
              "minimum": 1,
              "default": 3
            }
          }
        },
        "total": {
          "type": "object",
          "additionalProperties": false,
          "default": {
            "max_evidence_rounds": 3,
            "max_total_images": 8,
            "max_selector_calls": 4,
            "max_camera_actions": 3
          },
          "properties": {
            "max_evidence_rounds": {
              "type": "integer",
              "minimum": 0,
              "default": 3
            },
            "max_total_images": {
              "type": "integer",
              "minimum": 1,
              "default": 8
            },
            "max_selector_calls": {
              "type": "integer",
              "minimum": 1,
              "default": 4
            },
            "max_camera_actions": {
              "type": "integer",
              "minimum": 0,
              "default": 3
            }
          }
        },
        "escalation": {
          "type": "object",
          "additionalProperties": false,
          "default": {
            "on_no_feasible_candidate": true,
            "on_post_render_gate_insufficient": false,
            "on_selector_exception": false,
            "on_render_failure": false
