      "type": "object",
      "additionalProperties": false,
      "default": {
        "enabled": true,
        "backend": "deterministic",
        "allow_path_only_compatibility": false
      },
      "properties": {
        "enabled": {
          "const": true,
          "default": true
        },
        "backend": {
          "const": "deterministic",
          "default": "deterministic"
        },
        "allow_path_only_compatibility": {
          "const": false,
          "default": false
        }
      }
    },
    "judge": {
      "type": "object",
      "additionalProperties": false,
      "default": {
        "allow_need_more_evidence": true
      },
      "properties": {
        "allow_need_more_evidence": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "default": {
        "max_evidence_rounds": 3,
        "max_views_per_round": 2,
        "max_total_images": 8,
        "max_camera_actions": 3,
        "max_selector_calls": 4
      },
      "properties": {
        "max_evidence_rounds": {
          "type": "integer",
          "minimum": 0,
          "default": 3
        },
        "max_views_per_round": {
          "type": "integer",
          "minimum": 1,
          "default": 2
        },
        "max_total_images": {
          "type": "integer",
          "minimum": 1,
          "default": 8
        },
        "max_camera_actions": {
          "type": "integer",
          "minimum": 0,
          "default": 3
        },
        "max_selector_calls": {
          "type": "integer",
          "minimum": 1,
          "default": 4
        }
      }
    },
    "require_evidence_gate_after_render": {
      "const": true,
      "default": true
    },
    "on_non_camera_repairable_evidence": {
      "const": "unresolved",
      "default": "unresolved"
    },
    "on_budget_exhausted": {
      "const": "force_choice",
      "default": "force_choice"
    },
    "on_selector_failure": {
      "type": "string",
      "enum": [
        "keep_previous_evidence",
        "unresolved"
      ],
      "default": "keep_previous_evidence"
    },
    "on_render_failure": {
      "const": "unresolved",
      "default": "unresolved"
    }
