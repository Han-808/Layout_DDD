        "mode": {
          "const": "visibility_ranked",
          "default": "visibility_ranked"
        },
        "selector": {
          "const": "deterministic",
          "default": "deterministic"
        }
      }
    },
    "camera_acquisition": {
      "type": "object",
      "additionalProperties": false,
      "default": {
