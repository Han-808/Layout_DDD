          "properties": {
            "on_no_feasible_candidate": {
              "type": "boolean",
              "default": true
            },
            "on_post_render_gate_insufficient": {
              "const": false,
              "default": false
            },
            "on_selector_exception": {
              "const": false,
              "default": false
            },
            "on_render_failure": {
              "const": false,
              "default": false
            }
          }
        }
      }
