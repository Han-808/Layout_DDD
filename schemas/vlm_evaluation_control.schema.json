            "fixed",
            "deterministic_only",
            "vlm_only",
            "deterministic_then_vlm"
          ],
          "default": "deterministic_then_vlm"
        },
        "deterministic": {
          "type": "object",
          "additionalProperties": false,
          "default": {
            "max_rounds": 1,
            "candidate_budget": 8,
            "max_selected_views": 2,
            "ranking": {
              "geometry_feasible_bonus": 2.0,
              "geometry_unverified_penalty": -100.0,
              "target_visibility_bonus": 2.0,
              "joint_visibility_bonus": 2.0,
              "projected_coverage_weight": 2.0,
              "contact_cue_weight": 1.0,
              "pose_diversity_cap": 5.0,
              "pose_diversity_weight": 0.1,
              "view_family_match_bonus": 1.0,
              "unoccluded_bonus": 1.0
            }
          },
          "properties": {
            "max_rounds": {
              "type": "integer",
              "minimum": 0,
              "default": 1
            },
            "candidate_budget": {
              "type": "integer",
              "minimum": 1,
              "default": 8
            },
            "max_selected_views": {
              "type": "integer",
              "minimum": 1,
              "default": 2
            },
            "ranking": {
              "type": "object",
              "additionalProperties": false,
              "default": {
                "geometry_feasible_bonus": 2.0,
                "geometry_unverified_penalty": -100.0,
                "target_visibility_bonus": 2.0,
                "joint_visibility_bonus": 2.0,
                "projected_coverage_weight": 2.0,
                "contact_cue_weight": 1.0,
                "pose_diversity_cap": 5.0,
                "pose_diversity_weight": 0.1,
                "view_family_match_bonus": 1.0,
                "unoccluded_bonus": 1.0
              },
              "properties": {
                "geometry_feasible_bonus": {
                  "type": "number",
                  "minimum": 0,
                  "default": 2.0
                },
                "geometry_unverified_penalty": {
                  "type": "number",
                  "maximum": 0,
                  "default": -100.0
                },
                "target_visibility_bonus": {
                  "type": "number",
                  "minimum": 0,
                  "default": 2.0
                },
                "joint_visibility_bonus": {
                  "type": "number",
                  "minimum": 0,
                  "default": 2.0
                },
                "projected_coverage_weight": {
                  "type": "number",
                  "minimum": 0,
                  "default": 2.0
                },
                "contact_cue_weight": {
                  "type": "number",
                  "minimum": 0,
                  "default": 1.0
                },
                "pose_diversity_cap": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "default": 5.0
                },
                "pose_diversity_weight": {
                  "type": "number",
                  "minimum": 0,
                  "default": 0.1
                },
                "view_family_match_bonus": {
                  "type": "number",
                  "minimum": 0,
                  "default": 1.0
                },
                "unoccluded_bonus": {
                  "type": "number",
                  "minimum": 0,
                  "default": 1.0
                }
              }
            }
          }
        },
        "vlm": {
          "type": "object",
          "additionalProperties": false,
          "default": {
            "max_rounds": 1,
            "selection_mode": "repair_plan",
            "max_selected_views": 2,
            "max_repair_plans": 3
          },
          "properties": {
            "max_rounds": {
              "type": "integer",
              "minimum": 0,
              "default": 1
