        },
        "allow_scene_mutation": {
          "const": false,
          "default": false
        }
      }
    },
    "initial_group_camera": {
      "type": "object",
      "additionalProperties": false,
      "default": {
        "mode": "visibility_ranked",
        "selector": "deterministic"
      },
