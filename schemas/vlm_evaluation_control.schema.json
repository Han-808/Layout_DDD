{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://layout-ddd.local/schemas/vlm_evaluation_control.schema.json",
  "title": "VLM Evaluation Control",
  "description": "Additive control-plane configuration for Judge, CameraSelector, and deterministic EvidenceGate orchestration.",
  "type": "object",
  "additionalProperties": false,
  "default": {
    "schema_version": "vlm_evaluation_control_v2",
    "camera_selector": {
      "backend": "existing",
      "allow_freeform_pose": false,
      "allow_scene_mutation": false
    },
    "initial_group_camera": {
      "mode": "visibility_ranked",
      "selector": "deterministic"
    },
    "camera_acquisition": {
      "policy": "deterministic_then_vlm",
      "deterministic": {
        "max_rounds": 1,
        "candidate_budget": 8,
        "max_selected_views": 2,
        "ranking": {
          "geometry_feasible_bonus": 2.0,
          "geometry_unverified_penalty": -100.0,
          "target_visibility_bonus": 2.0,
          "joint_visibility_bonus": 2.0,
          "projected_coverage_weight": 2.0,
          "contact_cue_weight": 1.0,
          "pose_diversity_cap": 5.0,
          "pose_diversity_weight": 0.1,
          "view_family_match_bonus": 1.0,
          "unoccluded_bonus": 1.0
        }
      },
      "vlm": {
        "max_rounds": 1,
        "selection_mode": "repair_plan",
        "max_selected_views": 2,
        "max_repair_plans": 3
      },
      "total": {
