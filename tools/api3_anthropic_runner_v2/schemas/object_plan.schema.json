{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hy34_object_plan_v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "scene_type", "scene_description", "prompt_granularity",
    "global_constraints", "zones", "relations", "objects"
  ],
  "properties": {
    "schema_version": {"const": "hy34_object_plan_v2"},
    "scene_type": {"type": "string", "minLength": 1},
    "scene_description": {"type": "string", "minLength": 1},
    "prompt_granularity": {"const": "fine_grained"},
    "global_constraints": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "zones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "extent_hint"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "description": {"type": "string", "minLength": 1},
          "extent_hint": {"type": "string", "minLength": 1}
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["family", "type", "subject_id", "object_id"],
        "properties": {
          "family": {"type": "string", "minLength": 1},
          "type": {"type": "string", "minLength": 1},
          "subject_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "object_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
        }
      }
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "category", "role", "description", "count", "estimated_size",
          "metadata", "placement_intent"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "category": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "count": {"type": "integer", "minimum": 1},
          "estimated_size": {
            "type": "array", "minItems": 3, "maxItems": 3,
            "items": {"type": "number", "exclusiveMinimum": 0}
          },
          "metadata": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "intended_role", "zone", "support", "directed", "functional_side",
              "facing_intent", "retrieval_query", "requested_count"
            ],
            "properties": {
              "intended_role": {"type": "string", "minLength": 1},
              "zone": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
              "support": {"type": "string", "minLength": 1},
              "directed": {"type": "boolean"},
              "functional_side": {"enum": ["local_neg_y", null]},
              "facing_intent": {"type": ["string", "null"]},
              "retrieval_query": {"type": "string", "minLength": 1},
              "requested_count": {"type": "integer", "minimum": 1}
            }
          },
          "placement_intent": {
            "type": "object",
            "additionalProperties": false,
            "required": ["absolute_relations", "relative_relations"],
            "properties": {
              "absolute_relations": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "relative_relations": {"type": "array", "items": {"type": "string", "minLength": 1}}
            }
          }
        }
      }
    }
  }
}
