{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sceneeval-abstract-layout-v2-rooms-positive-coordinates",
  "title": "SceneEval Abstract Layout v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["rooms", "objects"],
  "properties": {
    "rooms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "origin_m", "size_m"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "category": {"type": "string", "minLength": 1},
          "origin_m": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {"type": "number", "minimum": 0}
          },
          "size_m": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {"type": "number", "exclusiveMinimum": 0}
          }
        }
      }
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "room_id",
          "category",
          "appearance",
          "position_m",
          "size_m",
          "yaw_deg"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "room_id": {"type": "string", "minLength": 1},
          "category": {"type": "string", "minLength": 1},
          "appearance": {"type": "string", "minLength": 1},
          "position_m": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {"type": "number", "minimum": 0}
          },
          "size_m": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {"type": "number", "exclusiveMinimum": 0}
          },
          "yaw_deg": {"type": "number"}
        }
      }
    }
  }
}
