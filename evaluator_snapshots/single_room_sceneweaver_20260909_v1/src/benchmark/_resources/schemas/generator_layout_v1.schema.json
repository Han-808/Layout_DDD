{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/layout-ddd/generator_layout_v1.schema.json",
  "title": "GeneratorLayoutV1",
  "description": "Minimal declarative JSON emitted by an LLM scene generator before adapter conversion.",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "scene_type", "coordinate_frame", "objects"],
  "properties": {
    "schema_version": {"const": "layout_json_v1"},
    "scene_id": {"type": "string", "minLength": 1},
    "scene_type": {"type": "string", "minLength": 1},
    "coordinate_frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "axes", "unit", "rotation_unit"],
      "properties": {
        "origin": {"enum": ["room_min_corner_floor", "room_center_floor"]},
        "axes": {"const": "x_width_y_depth_z_up"},
        "unit": {"const": "meter"},
        "rotation_unit": {"const": "degree"}
      }
    },
    "room": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "size": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": {"type": "number", "exclusiveMinimum": 0}
        },
        "boundary": {"$ref": "#/$defs/boundary"},
        "height": {"type": "number", "exclusiveMinimum": 0}
      },
      "allOf": [
        {
          "anyOf": [
            {"required": ["size"]},
            {"required": ["boundary"]}
          ]
        },
        {
          "anyOf": [
            {
              "required": ["size"],
              "properties": {"size": {"minItems": 3}}
            },
            {"required": ["height"]}
          ]
        }
      ]
    },
    "objects": {
      "type": "array",
      "items": {"$ref": "#/$defs/object"}
    },
    "relationships": {
      "type": "array",
      "items": {"$ref": "#/$defs/relationship"}
    }
  },
  "$defs": {
    "boundary": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {"type": "number"}
      }
    },
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "number"}
    },
    "positiveVec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "number", "exclusiveMinimum": 0}
    },
    "object": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "category", "center", "size", "rotation"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "center": {"$ref": "#/$defs/vec3"},
        "size": {"$ref": "#/$defs/positiveVec3"},
        "rotation": {
          "allOf": [{"$ref": "#/$defs/vec3"}],
          "description": "[roll_x, pitch_y, yaw_z] Euler rotation in degrees, applied to local column vectors as Rz(yaw_z) @ Ry(pitch_y) @ Rx(roll_x)."
        },
        "asset_id": {"type": "string", "minLength": 1},
        "support_parent": {"type": ["string", "null"]}
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": true,
      "required": ["family", "subject", "predicate", "object"],
      "properties": {
        "family": {"enum": ["oor", "oar"]},
        "subject": {"type": "string", "minLength": 1},
        "predicate": {"type": "string", "minLength": 1},
        "object": {"type": "string", "minLength": 1}
      }
    }
  }
}
